#!/bin/bash
# Очистка буфера обмена (Meta+V / Win+V в ProtocolOS)
set -u
cleared=0
if command -v qdbus6 >/dev/null; then
  qdbus6 org.kde.klipper /klipper org.kde.klipper.klipper.clearClipboardHistory >/dev/null 2>&1 && cleared=1
  qdbus6 org.kde.klipper /klipper clearClipboardContents >/dev/null 2>&1 && cleared=1
fi
if command -v qdbus >/dev/null; then
  qdbus org.kde.klipper /klipper org.kde.klipper.klipper.clearClipboardHistory >/dev/null 2>&1 && cleared=1
fi
# Wayland / X11 fallback
if command -v wl-copy >/dev/null; then
  wl-copy --clear >/dev/null 2>&1 && cleared=1
  printf '' | wl-copy >/dev/null 2>&1 && cleared=1
fi
if command -v xclip >/dev/null; then
  printf '' | xclip -selection clipboard >/dev/null 2>&1 && cleared=1
  printf '' | xclip -selection primary >/dev/null 2>&1 || true
fi
if command -v xsel >/dev/null; then
  printf '' | xsel -bc >/dev/null 2>&1 && cleared=1
fi
# файловый буфер ProtocolOS
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/protocolos/file-clipboard" 2>/dev/null || true
if command -v notify-send >/dev/null; then
  notify-send -a ProtocolOS -i edit-clear "Буфер обмена очищен" "Meta+V · история и содержимое сброшены"
fi
exit 0
