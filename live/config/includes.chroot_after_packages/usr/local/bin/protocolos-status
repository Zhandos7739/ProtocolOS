#!/bin/bash
# Печатает статус защиты в формате key=value (для виджета «Защита»).
# Один проход systemctl вместо четырёх отдельных вызовов.
set -u
mapfile -t st < <(systemctl is-active clamav-clamonacc clamav-daemon ufw opensnitch 2>/dev/null)
rt=off; [ "${st[0]:-}" = active ] && rt=on
av=off; [ "${st[1]:-}" = active ] && av=on
fw=off
if [ "${st[2]:-}" = active ] && grep -qs '^ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null; then fw=on; fi
sn=off; [ "${st[3]:-}" = active ] && sn=on
aa=0
[ -r /sys/kernel/security/apparmor/profiles ] && aa=$(grep -c enforce /sys/kernel/security/apparmor/profiles 2>/dev/null || echo 0)
db=$(stat -c %y /var/lib/clamav/daily.cvd /var/lib/clamav/daily.cld 2>/dev/null | head -1 | cut -c1-16)
last=$(cat /var/lib/protocolos/lastscan 2>/dev/null || echo "—")
bo=off; [ -e /run/protocolos-blackout.active ] && bo=on
printf 'realtime=%s\nclamd=%s\nufw=%s\nopensnitch=%s\napparmor=%s\ndb=%s\nlastscan=%s\nblackout=%s\n' \
  "$rt" "$av" "$fw" "$sn" "$aa" "${db:-нет}" "$last" "$bo"
