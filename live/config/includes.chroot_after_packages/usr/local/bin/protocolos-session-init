#!/bin/bash
# Создаёт правую колонку папок рабочего стола (Проекты, Документы, Загрузки, Изображения, Система, Корзина)
xdg-user-dirs-update
P=$HOME/.local/share/protocolos/places; mkdir -p "$P"
DOC=$(xdg-user-dir DOCUMENTS); mkdir -p "$DOC/Проекты"
# Папка для Win+Print Screen
mkdir -p "$(xdg-user-dir PICTURES)/Screenshots" "$(xdg-user-dir VIDEOS)/Screencasts" 2>/dev/null || true
# Горячие клавиши скриншотов (если пользователь ещё не менял)
if [ ! -f "$HOME/.config/protocolos/shortcuts-screenshots.done" ]; then
  mkdir -p "$HOME/.config/protocolos"
  if [ -f /etc/xdg/kglobalshortcutsrc ] && [ ! -f "$HOME/.config/kglobalshortcutsrc" ]; then
    cp /etc/xdg/kglobalshortcutsrc "$HOME/.config/kglobalshortcutsrc"
  fi
  if [ -f /etc/xdg/spectaclerc ] && [ ! -f "$HOME/.config/spectaclerc" ]; then
    cp /etc/xdg/spectaclerc "$HOME/.config/spectaclerc"
  fi
  touch "$HOME/.config/protocolos/shortcuts-screenshots.done"
fi
lnk(){ cat > "$P/$1.desktop" <<E
[Desktop Entry]
Type=Link
Name=$2
Icon=$3
URL=$4
E
}
lnk 1-projects Проекты folder-projects "file://$DOC/Проекты"
lnk 2-docs Документы folder-documents "file://$DOC"
lnk 3-down Загрузки folder-downloads "file://$(xdg-user-dir DOWNLOAD)"
lnk 4-pics Изображения folder-pictures "file://$(xdg-user-dir PICTURES)"
lnk 5-system Система folder-root "file:///"
lnk 6-trash Корзина user-trash "trash:/"
# Доверить ярлыки на рабочем столе (Plasma 6 спрашивает при первом запуске)
for f in "$(xdg-user-dir DESKTOP)"/*.desktop; do [ -e "$f" ] && chmod +x "$f" && gio set "$f" metadata::trusted true 2>/dev/null; done
touch "$HOME/.config/protocolos-session-init.done"
