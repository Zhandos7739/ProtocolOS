#!/bin/bash
# Полный запрет камеры по умолчанию. Разрешение — только явно (как USBGuard).
set -u
STATE="$HOME/.config/protocolos/camera-allowed"
HELPER=/usr/local/lib/protocolos/camera-acl.sh
mkdir -p "$(dirname "$STATE")"

notify() {
  command -v notify-send >/dev/null || return 0
  notify-send -a ProtocolOS -i camera-web "$@"
}

ask() {
  if command -v kdialog >/dev/null; then
    kdialog --title "Камера — ProtocolOS" --yesno "$1" --yes-label "Разрешить" --no-label "Запретить"
    return $?
  fi
  return 1
}

acl() {
  if [ -x "$HELPER" ]; then
    if command -v pkexec >/dev/null; then
      pkexec "$HELPER" "$@" >/dev/null 2>&1 && return 0
    fi
    "$HELPER" "$@" >/dev/null 2>&1 && return 0
  fi
  # fallback без root: только uaccess через chmod где возможно
  case "$1" in
    deny)
      for v in /dev/video*; do [ -e "$v" ] && chmod 000 "$v" 2>/dev/null || true; done ;;
    allow)
      for v in /dev/video*; do [ -e "$v" ] && chmod 660 "$v" 2>/dev/null || true; done ;;
  esac
}

status() {
  local blocked=1
  for v in /dev/video*; do
    [ -e "$v" ] || continue
    if [ -r "$v" ] 2>/dev/null; then blocked=0; break; fi
  done
  if [ -f "$STATE" ]; then echo "policy=allow"; else echo "policy=deny"; fi
  echo "device_blocked=$blocked"
}

case "${1:-status}" in
  status) status ;;
  deny|block|off)
    rm -f "$STATE"
    acl deny
    notify "Камера выключена" "Устройства /dev/video* заблокированы"
    ;;
  allow|on)
    if [ "${2:-}" != "--force" ]; then
      ask "Разрешить доступ к камере?\n\nПо умолчанию камера полностью запрещена.\nРазрешение действует до выхода из сессии (или до «Запретить»)." || exit 1
    fi
    date -Is > "$STATE"
    acl allow
    notify "Камера разрешена" "Не забудьте снова запретить после использования"
    ;;
  toggle)
    if [ -f "$STATE" ]; then "$0" deny; else "$0" allow; fi
    ;;
  ensure-denied)
    # автозапуск сессии: если пользователь не разрешал — держать блок
    if [ ! -f "$STATE" ]; then acl deny; fi
    ;;
  *)
    echo "usage: $0 status|allow|deny|toggle|ensure-denied"
    exit 2
    ;;
esac
