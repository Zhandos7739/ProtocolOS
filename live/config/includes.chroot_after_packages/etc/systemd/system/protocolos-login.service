[Unit]
Description=ProtocolOS: set login protocol/protocol
After=live-config.service
ConditionKernelCommandLine=boot=live
Before=display-manager.service sddm.service systemd-user-sessions.service
[Service]
Type=oneshot
ExecStart=/usr/local/lib/protocolos/set-login.sh
[Install]
WantedBy=multi-user.target
