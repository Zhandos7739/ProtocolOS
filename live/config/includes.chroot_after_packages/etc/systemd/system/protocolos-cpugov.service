[Unit]
Description=ProtocolOS: CPU governor schedutil
[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do grep -qw schedutil ${g%%/scaling_governor}/scaling_available_governors 2>/dev/null && echo schedutil > $g; done; true'
[Install]
WantedBy=multi-user.target
